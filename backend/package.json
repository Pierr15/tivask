{
  "name": "@tivask/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:vector": "tsx scripts/enable-vector.ts"
  },
  "dependencies": {
    "@google/genai": "^1.44.0",
    "@prisma/client": "6.19.0",
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "dotenv": "^17.2.3",
    "zod": "^3.25.76",
    "pino": "^9.14.0",
    "multer": "^2.0.2",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.34.7",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/express": "^5.0.5",
    "@types/cors": "^2.8.19",
    "@types/cookie-parser": "^1.4.9",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/pg": "^8.15.6",
    "prisma": "6.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3"
  }
}
